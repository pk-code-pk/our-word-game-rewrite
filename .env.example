NODE_ENV=development
PORT=3001

# Local development fallback. Leave DATABASE_URL unset to use SQLite under ./data.
DATABASE_FILE=data/fourfive.db

# Production / hosted database. The app prefers DATABASE_URL when present.
# For Neon, use the pooled connection string from your Neon project.
DATABASE_URL=

# Frontend API base. Leave blank for same-origin local dev and same-origin Vercel deploys.
VITE_API_BASE_URL=
