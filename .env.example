NODE_ENV=development
PORT=3001

# Local development fallback. Leave DATABASE_URL unset to use SQLite under ./data.
DATABASE_FILE=data/fourfive.db

# Production / hosted database. The app prefers DATABASE_URL when present.
# For Neon, use the pooled connection string from your Neon project.
DATABASE_URL=

# Frontend API base. Leave blank for same-origin local dev and same-origin Vercel deploys.
VITE_API_BASE_URL=

# Supabase Realtime (broadcast-as-signal for live game updates).
# Client (exposed to the browser via Vite): project URL + anon key.
VITE_SUPABASE_URL=https://lqsqyignnzdakyelewco.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side broadcast (server/realtime.ts). SUPABASE_URL mirrors the project
# URL above; SUPABASE_SERVICE_ROLE_KEY is secret — never expose it to the client.
SUPABASE_URL=https://lqsqyignnzdakyelewco.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
